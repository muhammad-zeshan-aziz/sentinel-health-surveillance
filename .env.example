# ==============================================================================
# Sentinel Health Surveillance - Environment Configuration Template
# ==============================================================================

# Database Settings
# Local SQLite default:
DATABASE_URL=sqlite:///./sentinel.db
# PostgreSQL / PostGIS production:
# DATABASE_URL=postgresql+psycopg2://sentinel:sentinel_pass@db:5432/sentinel_db

# Security & Authentication
SECRET_KEY=sentinel_secret_dev_key_2026_super_secure_idsr_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Patient Pseudonymization HMAC Pepper (Keep Secret!)
SALT_PEPPER=KP_HEALTH_IDS_SECRET_PEPPER_2026_PROD_READY

# Application Settings
ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173

# Server Settings
HOST=0.0.0.0
PORT=8000
